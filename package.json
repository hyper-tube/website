{
  "name": "ht-website",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build && tsc -p tsconfig.server.json",
    "dev": "cross-env NODE_ENV=development tsx --conditions development --env-file-if-exists=.env server.ts",
    "start": "cross-env NODE_ENV=production node --env-file-if-exists=.env dist/server.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "palette": "tsx scripts/palette.ts"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@react-router/express": "^8.3.1",
    "@react-router/node": "^8.3.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "isbot": "^5.2.2",
    "morgan": "^1.12.1",
    "motion": "^13.2.0",
    "pretty-cache-header": "^1.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-router": "^8.3.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github": "^12.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remix-i18next": "^8.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "unified": "^11.0.5",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/material-symbols": "^1.2.92",
    "@iconify-json/mdi": "^1.2.3",
    "@react-router/dev": "^8.3.1",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/hast": "^3.0.5",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.0"
  }
}
